{
  "background_color": "#0e1415",
  "description": "In-browser Digital Audio Workstation template powered by ShadowClaw.",
  "display": "standalone",
  "id": "shadow-claw-daw",
  "name": "ShadowClaw DAW",
  "short_name": "ShadowClaw DAW",
  "start_url": ".",
  "scope": ".",
  "theme_color": "#0e1415",
  "share_target": {
    "action": "share/share-target.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "*/*",
            "application/*",
            "text/*",
            "image/*",
            "audio/*",
            "video/*",
            "application/octet-stream"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "name": "Audio and Project Files",
      "icons": [
        {
          "src": "assets/icons/192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/vnd.dawproject+zip": [".dawproject"],
        "audio/midi": [".mid", ".midi"],
        "application/json": [".json", ".scdaw.json"],
        "audio/wav": [".wav"],
        "audio/x-wav": [".wav"]
      }
    }
  ],
  "icons": [
    {
      "purpose": "any",
      "sizes": "any",
      "src": "assets/icons/favicon.svg",
      "type": "image/svg+xml"
    },
    {
      "purpose": "any",
      "sizes": "48x48",
      "src": "assets/icons/48.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "72x72",
      "src": "assets/icons/72.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "96x96",
      "src": "assets/icons/96.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "128x128",
      "src": "assets/icons/128.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "152x152",
      "src": "assets/icons/152.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "180x180",
      "src": "assets/icons/180.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "192x192",
      "src": "assets/icons/192.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "512x512",
      "src": "assets/icons/512.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "1024x1024",
      "src": "assets/icons/1024.png",
      "type": "image/png"
    },
    {
      "purpose": "maskable",
      "sizes": "1024x1024",
      "src": "assets/icons/1024.png",
      "type": "image/png"
    }
  ],
  "screenshots": [
    {
      "form_factor": "wide",
      "label": "ShadowClaw DAW Studio Workbench",
      "sizes": "1024x768",
      "src": "assets/screenshots/scdaw-workbench-1024x768.png",
      "type": "image/png"
    }
  ]
}
